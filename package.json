{
  "name": "rings-wallet",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Rings Wallet: a Solana wallet (Chrome extension) with the Rings private balance built in.",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "pretest": "node scripts/link-shared.mjs",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "node scripts/link-shared.mjs && tsc --noEmit"
  },
  "dependencies": {
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "@scure/bip39": "1.6.0",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/chrome": "0.0.287",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "ed25519-hd-key": "1.3.0",
    "esbuild": "0.28.2",
    "tsx": "^4.20.6",
    "tweetnacl": "1.0.3",
    "typescript": "^5.9.3"
  }
}
